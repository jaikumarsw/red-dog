# =============================================================================
# Red Dog Radios — Backend environment (copy to .env and fill in values)
# Required at startup: JWT_SECRET, MONGO_URI (see src/server.js)
# =============================================================================

# --- Core ---
NODE_ENV=development
PORT=4000

# --- Database ---
MONGO_URI=mongodb://127.0.0.1:27017/reddog_db

# --- Auth (required) ---
JWT_SECRET=generate_a_long_random_string_do_not_use_this_literal
JWT_EXPIRES_IN=7d

# --- Admin / alerts (cron, dev email test route) ---
ADMIN_EMAIL=
# Optional: where inbound reply routing may notify (if wired in your deployment)
ADMIN_REPLY_EMAIL=

# --- Public app URLs (no trailing slash) ---
# Production example; local dev often http://localhost:3000
FRONTEND_URL=https://red-dog-frontend-production.up.railway.app
# Browser origin allowed to call this API (usually same as FRONTEND_URL)
CORS_ORIGIN=https://red-dog-frontend-production.up.railway.app

# --- Outbound email (Nodemailer) ---
# Gmail: smtp.gmail.com, 587, SMTP_SECURE=false
# Hostinger: smtp.hostinger.com, 465, SMTP_SECURE=true
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# When NODE_ENV is not production, if set, all outbound mail goes here instead
# DEV_REDIRECT_EMAIL=

# --- Gmail OAuth (legacy; src/config/gmail.config.js) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:4000/api/gmail/oauth/callback

# --- Nylas (https://dashboard.nylas.com) ---
NYLAS_API_KEY=
NYLAS_CLIENT_ID=
NYLAS_CLIENT_SECRET=
# If the frontend proxies /api to this server (Next.js rewrite), use FRONTEND_URL + /api/...
NYLAS_REDIRECT_URI=https://red-dog-frontend-production.up.railway.app/api/nylas/oauth/callback
NYLAS_API_URI=https://api.us.nylas.com

# --- OpenAI ---
OPENAI_API_KEY=
# Optional override (default in code: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# --- Simpler.Grants.gov (https://simpler.grants.gov/developer) ---
SIMPLER_GRANTS_API_KEY=
GRANTS_GOV_MIN_SAFETY_SCORE=8

# --- Stripe (https://dashboard.stripe.com) ---
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_BASIC=price_REPLACE_ME
STRIPE_PRICE_PREMIUM=price_REPLACE_ME
STRIPE_SUCCESS_URL=https://red-dog-frontend-production.up.railway.app/account/billing?status=success
STRIPE_CANCEL_URL=https://red-dog-frontend-production.up.railway.app/pricing?status=cancelled

# --- Cloudinary (file uploads; src/config/cloudinary.config.js) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Minimum fit score (0-100) for agency-specific grant results
AGENCY_MIN_FIT_SCORE=50

# --- E2E / scripts (optional) ---
# DOTENV_CONFIG_PATH=.env
